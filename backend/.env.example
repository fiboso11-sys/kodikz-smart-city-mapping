# =============================================================================
# Kodikz GPS Backend — environment template (Ubuntu 22.04 VPS)
# =============================================================================
# Copy to .env on the server (never commit .env):
#   cp .env.example .env
#
# Loaded automatically by config.js (dotenv) and PM2 via ecosystem.config.cjs.
# =============================================================================

# --- Runtime ---
NODE_ENV=production
SERVICE_NAME=kodikz-gps-backend
# APP_VERSION=1.0.0

# --- Network bind ---
# TCP must accept devices from the public internet (or VPN).
HOST=0.0.0.0
TCP_PORT=5000

# HTTP API: bind loopback only; Nginx terminates TLS and proxies here.
API_HOST=127.0.0.1
API_PORT=3000

# --- Security / proxy ---
# Comma-separated Vercel frontend URL(s) — required in production
CORS_ORIGIN=https://kodikz-dubai-mapping.vercel.app,https://your-production-app.vercel.app

# Set false only if Express is exposed directly without Nginx
TRUST_PROXY=true

# --- TCP hardening ---
TCP_HANDSHAKE_TIMEOUT_MS=30000
TCP_MAX_BUFFER_BYTES=262144

# --- HTTP security (optional) ---
# API_KEY=                          # When set, /vehicle & /vehicles need X-Api-Key (leave unset for Vercel browser)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# --- Simulation (same /vehicle & /vehicles API as live GPS) ---
# SIMULATION_MODE=true
# SIMULATION_INTERVAL_MS=2000
# SIMULATION_IMEIS=352093089674033,352093089674034,352093089674035,352093089674036,352093089674037

# Optional: alternate path to .env (rare)
# DOTENV_PATH=/opt/kodikz-gps/backend/.env
