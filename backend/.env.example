# kodikz-gps-backend — copy to .env (never commit .env)

NODE_ENV=production

PORT=3000
TCP_PORT=5000

MONGO_URI=mongodb://mongo:27017/kodikz

DOMAIN=api-kodikz.giantphoenixllc.com
PUBLIC_API_URL=https://api-kodikz.giantphoenixllc.com

CORS_ORIGIN=https://your-frontend-domain.com

HOST=0.0.0.0
API_HOST=0.0.0.0
TRUST_PROXY=true

HISTORY_DEFAULT_LIMIT=50
HISTORY_MAX_LIMIT=500

TCP_HANDSHAKE_TIMEOUT_MS=30000
TCP_MAX_BUFFER_BYTES=262144

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

SOCKET_PATH=/socket.io

# API_KEY=
