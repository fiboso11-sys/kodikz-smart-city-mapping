# =============================================================================
# Dubai Street Mapping Monitoring System — Environment Template
# Copy to .env.local for local development. Set in Vercel for production.
# =============================================================================

# --- GPS / API (required for live fleet) -------------------------------------
# Production VPS backend (default if unset)
NEXT_PUBLIC_API_URL=https://api-kodikz.giantphoenixllc.com
NEXT_PUBLIC_SOCKET_URL=https://api-kodikz.giantphoenixllc.com
NEXT_PUBLIC_GPS_API_URL=https://api-kodikz.giantphoenixllc.com

# --- Map ---------------------------------------------------------------------
NEXT_PUBLIC_MAP_PROVIDER=maplibre

# --- SQLite (optional) -------------------------------------------------------
# Default: ./data/giscd.db (created on first API call)
# SQLITE_PATH=./data/giscd.db

# --- Phase 2 (not used in Phase 1 pilot) -------------------------------------
# DATABASE_URL=postgresql://user:pass@host:5432/giscd_mapping

# --- Build (optional, Windows EPERM workaround) ------------------------------
# NEXT_DIST_DIR=.next-release
