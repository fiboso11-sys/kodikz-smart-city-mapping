# Local development
DEPLOYMENT_MODE=local
MOCK_AUTH_ENABLED=true
AUTH_PROVIDER=mock
AUTH_JWT_SECRET=local-dev-only-secret-change-me-32chars

# Optional: use Postgres locally
# DATABASE_URL=postgresql://kodikz:kodikz_local@localhost:5432/giscd
# FORCE_POSTGRES=true

STORAGE_PROVIDER=local
UPLOAD_MAX_BYTES=8388608

NEXT_PUBLIC_API_URL=https://api-kodikz.giantphoenixllc.com
NEXT_PUBLIC_SOCKET_URL=https://api-kodikz.giantphoenixllc.com
NEXT_PUBLIC_MAP_PROVIDER=maplibre

GEOCODING_PROVIDER=nominatim
LOG_LEVEL=debug
WORKER_ENABLED=false
