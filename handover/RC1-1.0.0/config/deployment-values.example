# Non-interactive deployment values (EXAMPLE ONLY — no real secrets)
# Copy to deployment-values.env, fill securely, chmod 600, then:
#   ./scripts/configure.sh --non-interactive
#
# Never commit deployment-values.env or .env.production

IMAGE_SOURCE=offline
FRONTEND_PUBLIC_URL=https://survey-pilot.example.ae
BACKEND_PUBLIC_URL=https://survey-pilot.example.ae
GPS_BACKEND_URL=https://api-kodikz.giantphoenixllc.com
POSTGRES_DB=giscd
POSTGRES_USER=kodikz
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_16CHARS_MIN
MONGODB_URL=
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY_ID=REPLACE_WITH_STRONG_ACCESS_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_STRONG_SECRET_KEY_16CHARS
AUTH_JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_SECRET_VALUE_HERE_XXXXXXXX
CORS_ORIGINS=https://survey-pilot.example.ae
ADMIN_EMAIL=admin@example.ae
TLS_MODE=terminate-nginx
TLS_CERT_DIR=./data/certs
BACKUP_RETENTION_DAYS=14
HTTP_PORT=80
HTTPS_PORT=443
