# Dubai Municipality production — external managed services
DEPLOYMENT_MODE=municipality
APP_URL=https://giscd-survey.dm.gov.ae

AUTH_PROVIDER=oidc
AUTH_JWT_SECRET=REPLACE_WITH_MUNICIPALITY_SECRET
AUTH_COOKIE_SECURE=true
MOCK_AUTH_ENABLED=false
OIDC_ISSUER=https://sso.municipality.example/realms/giscd
OIDC_CLIENT_ID=kodikz-survey
OIDC_CLIENT_SECRET=REPLACE_ME

DATABASE_URL=postgresql://USER:PASS@municipality-pg-host:5432/giscd
DATABASE_SSL=true
DATABASE_POOL_MAX=40

STORAGE_PROVIDER=s3
S3_ENDPOINT=https://s3.municipality.example
S3_REGION=me-central-1
S3_BUCKET=giscd-survey-evidence
S3_ACCESS_KEY_ID=REPLACE_ME
S3_SECRET_ACCESS_KEY=REPLACE_ME
S3_FORCE_PATH_STYLE=false

REDIS_ENABLED=true
REDIS_URL=redis://municipality-redis:6379

WORKER_ENABLED=true

# Existing GPS backend (unchanged)
NEXT_PUBLIC_API_URL=https://gps-api.municipality.example
NEXT_PUBLIC_SOCKET_URL=https://gps-api.municipality.example

GEOCODING_PROVIDER=municipality
LOG_LEVEL=info
