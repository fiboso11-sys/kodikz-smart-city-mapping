# VPS API (Nginx HTTPS in production — local dev uses port 3000)
NEXT_PUBLIC_GPS_API_URL=http://localhost:3000
NEXT_PUBLIC_GPS_PROVIDER=teltonika

# Optional: map a single device to one fleet vehicle when seed IMEIs are empty
# NEXT_PUBLIC_GPS_IMEI=352093089674033
# NEXT_PUBLIC_GPS_VEHICLE_ID=vh-001
